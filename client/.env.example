# local  = Express + Prisma + SQLite API   |   firebase = Firestore + Auth + Storage
VITE_BACKEND=local
# Only needed if the API is on another domain (e.g. client on Firebase Hosting, API on a VPS)
VITE_API_URL=

# Only needed when VITE_BACKEND=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
