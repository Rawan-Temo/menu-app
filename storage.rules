rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /restaurants/{slug}/{file} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 4 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*')
                   && firestore.get(/databases/(default)/documents/restaurants/$(slug)).data.ownerUid == request.auth.uid;
    }
  }
}
