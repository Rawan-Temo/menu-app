# Copy to .env
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
# Comma-separated origins allowed when the client is hosted elsewhere (e.g. Firebase Hosting). Empty = allow all.
CORS_ORIGIN=
# Set to false to stop new sign-ups once you onboard customers yourself
ALLOW_REGISTER=true
